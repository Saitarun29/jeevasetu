# ==============================================================================
# JEEVASETU — Environment Variables Example
# Duplicate this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# Client-Side Firebase Configuration (Required for browser authentication & Firestore)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jeevasetu-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jeevasetu-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jeevasetu-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Server-Side Firebase Admin SDK (Used in Node.js Route Handlers only)
# For local development with service account credentials:
FIREBASE_PROJECT_ID=jeevasetu-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@jeevasetu-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQDExampleKey\n-----END PRIVATE KEY-----\n"

# Transactional Email via Resend (Server-Side Only)
RESEND_API_KEY=re_123456789_abcdef
RESEND_FROM_EMAIL=JEEVASETU Care <onboarding@resend.dev>

# Google Cloud Scheduler Cron Trigger Protection (Server-Side Only)
CRON_SECRET=super-secret-cron-token-min-32-chars

# Required: HMAC pepper for invitation passcodes (>= 32 characters).
# Invitation redemption fails closed if this is missing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITATION_PEPPER=replace-with-64-char-random-hex

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
